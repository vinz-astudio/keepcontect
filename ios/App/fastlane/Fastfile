# TestFlight pipeline for the iOS passive-unlock spike (KC-IOS-UNLOCK-SPIKE-001).
#
# Signing is explicit and distribution-only, for a reason worth writing down.
#
# Xcode's automatic signing cannot work on this runner: `xcodebuild archive`
# signs the archive with a *development* identity and only re-signs with the
# distribution identity at export time, so automatic provisioning goes looking
# for an iOS App Development profile — which Apple will not issue to a team
# with no registered devices. A CI machine is never a registered device.
#
# So the archive is signed directly with the App Store profile instead, which
# never involves a development profile at all. The one trap here is that
# `get_certificates` installs into the login keychain by default, and on CI
# that keychain is locked — that is what produced "Could not find the newly
# generated certificate installed" on the first attempt. It has to be pointed
# at the temporary keychain `setup_ci` creates and unlocks.

default_platform(:ios)

APP_IDENTIFIER = "com.keepcontact.app"

platform :ios do
  desc "Build and upload a build to TestFlight"
  lane :beta do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      in_house: false
    )

    setup_ci(force: true)

    increment_version_number(
      version_number: options[:marketing_version],
      xcodeproj: "App.xcodeproj"
    )
    increment_build_number(
      build_number: options[:build_number],
      xcodeproj: "App.xcodeproj"
    )

    # The keychain setup_ci just created and unlocked. Without this the
    # certificate lands somewhere xcodebuild cannot read.
    keychain_path = lane_context[SharedValues::KEYCHAIN_PATH] ||
                    File.expand_path("~/Library/Keychains/fastlane_tmp_keychain")

    get_certificates(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: ""
    )
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      # No shared scheme is committed, so xcodebuild autocreates one; naming the
      # configuration explicitly keeps the archive off Debug either way.
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      # Internal testers get the build once processing finishes; waiting here
      # would just burn runner minutes.
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
