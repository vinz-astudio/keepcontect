# TestFlight pipeline for the iOS passive-unlock spike (KC-IOS-UNLOCK-SPIKE-001).
#
# Signing is delegated to Xcode's own automatic provisioning, driven by the
# App Store Connect API key (-allowProvisioningUpdates). fastlane's
# get_certificates/get_provisioning_profile were tried first and failed on the
# runner with "Could not find the newly generated certificate installed": they
# create the certificate through the API but then have to import it into a
# temporary keychain, and that import is the fragile part on CI. Letting
# xcodebuild own the whole identity lifecycle removes that step entirely.

require "tmpdir"

default_platform(:ios)

APP_IDENTIFIER = "com.keepcontact.app"

platform :ios do
  desc "Build and upload a build to TestFlight"
  lane :beta do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      in_house: false
    )

    # Creates and unlocks a temporary keychain, which is where Xcode will put
    # the signing identity it provisions.
    setup_ci(force: true)

    # xcodebuild wants the key as a file on disk, not as an env string.
    key_path = File.join(Dir.tmpdir, "asc_api_key.p8")
    File.write(key_path, ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"))

    increment_version_number(
      version_number: options[:marketing_version],
      xcodeproj: "App.xcodeproj"
    )
    increment_build_number(
      build_number: options[:build_number],
      xcodeproj: "App.xcodeproj"
    )

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: true,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"]
    )

    provisioning_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')}"
    ].join(" ")

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: provisioning_args,
      export_xcargs: provisioning_args,
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      # Internal testers get the build once processing finishes; waiting here
      # would just burn runner minutes.
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
