# TestFlight pipeline for the iOS passive-unlock spike (KC-IOS-UNLOCK-SPIKE-001).
#
# Signing is explicit and distribution-only, for a reason worth writing down.
#
# Xcode's automatic signing cannot work on this runner: `xcodebuild archive`
# signs the archive with a *development* identity and only re-signs with the
# distribution identity at export time, so automatic provisioning goes looking
# for an iOS App Development profile — which Apple will not issue to a team
# with no registered devices. A CI machine is never a registered device.
#
# So the archive is signed directly with the App Store profile instead, which
# never involves a development profile at all. The one trap here is that
# `get_certificates` installs into the login keychain by default, and on CI
# that keychain is locked — that is what produced "Could not find the newly
# generated certificate installed" on the first attempt. It has to be pointed
# at the temporary keychain `setup_ci` creates and unlocks.

require "xcodeproj"

default_platform(:ios)

APP_IDENTIFIER = "com.keepcontact.app"

platform :ios do
  desc "Build and upload a build to TestFlight"
  lane :beta do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      in_house: false
    )

    setup_ci(force: true)

    increment_version_number(
      version_number: options[:marketing_version],
      xcodeproj: "App.xcodeproj"
    )
    increment_build_number(
      build_number: options[:build_number],
      xcodeproj: "App.xcodeproj"
    )

    # The keychain setup_ci just created and unlocked. Without this the
    # certificate lands somewhere xcodebuild cannot read.
    #
    # The lane context reports the keychain by name, but the file on disk
    # carries the "-db" suffix, and get_certificates validates the literal
    # path — so resolve to whichever actually exists rather than guessing.
    keychain_path = [
      File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"),
      File.expand_path("~/Library/Keychains/fastlane_tmp_keychain")
    ].find { |candidate| File.exist?(candidate) }
    UI.user_error!("setup_ci did not leave a keychain behind") if keychain_path.nil?

    # Auto-prune oldest distribution certificate if Apple Developer Portal's
    # limit (2 or 3 active certs) is reached on headless CI runners.
    begin
      all_certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = (all_certs || []).select { |c| c.certificate_type.to_s.upcase.include?("DIST") }
      UI.message("Found #{dist_certs.count} active distribution certificates on Apple Developer Portal")
      if dist_certs.count >= 2
        oldest = dist_certs.sort_by { |c| c.expiration_date || "" }.first
        if oldest
          UI.important("Pruning oldest distribution cert #{oldest.id} (#{oldest.name}) to stay under Apple 3-cert limit")
          oldest.delete!
        end
      end
    rescue => e
      UI.error("Certificate pruning notice: #{e.message}")
    end

    get_certificates(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: "",
      force: true
    )
    # The entitlements file asks for HealthKit, and a profile only carries a
    # capability the App ID actually has — so without this the build fails at
    # signing with a mismatch that reads like a certificate problem. Enabling it
    # here rather than by hand in the portal keeps the requirement next to the
    # entitlement that creates it. HealthKit is self-serve; nothing here needs
    # Apple's approval.
    begin
      bundle_id = Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
      if bundle_id.nil?
        UI.important("Bundle ID #{APP_IDENTIFIER} not found; leaving capabilities untouched")
      else
        existing = bundle_id.get_capabilities.map { |c| c.capability_type.to_s }
        if existing.any? { |t| t.include?("HEALTHKIT") }
          UI.message("HealthKit capability already enabled on #{APP_IDENTIFIER}")
        else
          bundle_id.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT)
          UI.success("Enabled HealthKit capability on #{APP_IDENTIFIER}")
        end
      end
    rescue => e
      # Not fatal on its own: if the capability really is missing, the signing
      # step fails right after with a far clearer message than anything that
      # could be guessed here.
      UI.error("HealthKit capability check failed: #{e.message}")
    end

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    # Push needs an aps-environment entitlement, and the Capacitor template
    # ships no entitlements file. Wiring it here rather than hand-editing
    # project.pbxproj keeps the change reviewable and scoped to the App target —
    # a global xcargs override would also hit every Pods target.
    # Raw Ruby resolves relative paths against the Fastfile's own directory,
    # not the Xcode project directory that fastlane actions use.
    Xcodeproj::Project.open(File.expand_path("../App.xcodeproj", __dir__)).tap do |project|
      app_target = project.targets.find { |t| t.name == "App" }
      UI.user_error!("App target not found in App.xcodeproj") if app_target.nil?
      app_target.build_configurations.each do |config|
        config.build_settings["CODE_SIGN_ENTITLEMENTS"] = "App/App.entitlements"
      end
      project.save
    end

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      # No shared scheme is committed, so xcodebuild autocreates one; naming the
      # configuration explicitly keeps the archive off Debug either way.
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      # Internal testers get the build once processing finishes; waiting here
      # would just burn runner minutes.
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
